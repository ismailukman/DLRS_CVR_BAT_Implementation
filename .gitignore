# participant data and outputs (never tracked)
data*/
results/
participants.tsv
*.xlsx

# atlases (download into the empty folders; see README)
preprocessing/atlas/**
!preprocessing/atlas/*/
!preprocessing/atlas/*/.gitkeep

# pretrained weights and SPM12 (installed separately)
model/*.pt
preprocessing/spm12/*
!preprocessing/spm12/.gitkeeper

# local run files
fmriprep/local_config.json
fmriprep/logs/
fmriprep/*.csv
fmriprep/*.txt
preprocessing/*.log

# Python and system files
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
.idea/
.vscode/
